{
  "name": "frontier-brawler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "validate": "npm run validate:professions && npm run validate:equipment && npm run validate:economy && npm run validate:save && npm run validate:audio && npm run validate:touch && npm run validate:fixed-step && npm run check:cocos && npm run validate:cocos-sprites && npm run validate:cocos-camera && npm run validate:native-stage && npm run validate:loop && npm run validate:difficulty && npm run validate:tutorial && npm run build && node tools/validate_release.mjs",
    "validate:professions": "node tools/validate_professions.mjs",
    "validate:equipment": "node tools/validate_equipment.mjs",
    "validate:economy": "node tools/validate_economy.mjs",
    "validate:save": "node tools/validate_save.mjs",
    "validate:audio": "node tools/validate_audio.mjs",
    "validate:touch": "node tools/validate_touch.mjs",
    "validate:fixed-step": "node tools/validate_fixed_step.mjs",
    "validate:native-stage": "node tools/validate_native_stage.mjs",
    "validate:cocos-sprites": "node tools/validate_cocos_sprite_map.mjs",
    "validate:cocos-camera": "node tools/validate_cocos_camera.mjs",
    "validate:loop": "node tools/validate_loop.mjs",
    "validate:difficulty": "node tools/validate_difficulty.mjs",
    "validate:tutorial": "node tools/validate_tutorial.mjs",
    "validate:release": "npm run build && node tools/validate_release.mjs",
    "build:building-art": "python3 tools/build_building_atlas.py --all",
    "benchmark:50": "node tools/benchmark_50_units.mjs",
    "simulate:validation": "node tools/simulate_validation.mjs",
    "build:cocos-core": "node tools/build_cocos_core.mjs",
    "check:cocos": "npm run build:cocos-core && tsc -p native/cocos-poc/tsconfig.check.json --noEmit",
    "sync:cocos-art": "node tools/sync_cocos_art.mjs",
    "build:cocos-web": "node tools/build_cocos_web.mjs",
    "preview:cocos-web": "vite native/cocos-poc/build/web-mobile --host 127.0.0.1 --port 5190",
    "build:cocos-android": "node tools/build_cocos_android.mjs",
    "sync:godot": "node tools/export_godot_data.mjs",
    "validate:godot": "node tools/validate_godot.mjs",
    "dev:godot": "godot --path native/godot",
    "dev:motion-lab": "godot --path native/godot scenes/motion_lab.tscn",
    "export:motion-review": "godot --headless --path native/godot --script tests/export_motion_review.gd"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
